{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rusty Todo.txt Manager",
  "mainBinaryName": "rtmapp",
  "version": "0.1.0",
  "identifier": "com.brcha.rtm",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rusty Todo.txt Manager",
        "width": 900,
        "height": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US"],
        "upgradeCode": "e0e423d1-1101-50d4-baee-4a27fa127509"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
